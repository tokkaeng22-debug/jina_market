# 이 파일을 .env.local로 복사한 뒤 값을 채우세요. (.env.local은 커밋되지 않습니다)
# 0단계에서는 아무 값이 없어도 사이트가 실행됩니다.

# ── 사이트 ─────────────────────────────────────────────
# 배포 도메인 (sitemap · canonical · hreflang · OG에 쓰임). 끝에 / 없이.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 정식 오픈 때만 Vercel Production 환경변수로 true를 넣는다. 그 전에는 검색엔진에 노출되지 않는다.
SITE_INDEXABLE=

# ── Supabase (DB · 로그인) ─────────────────────────────
# Supabase 대시보드 > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 (웹훅에서 권한 부여할 때만 사용, 절대 NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SECRET_KEY=

# ── Cloudflare (1~2단계에서 사용) ─────────────────────
CLOUDFLARE_ACCOUNT_ID=
# R2: 전자책 · 과제 파일
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Stream: 강의 영상
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=

# ── 결제 (1단계에서 사용) ─────────────────────────────
# 국내: PortOne V2 (테스트는 KG이니시스 채널, 실연동 때 채널 키만 바꾼다)
# PORTONE_WEBHOOK_SECRET은 선택: 넣으면 웹훅 서명을 검증한다
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
# 해외: Lemon Squeezy (Merchant of Record)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
